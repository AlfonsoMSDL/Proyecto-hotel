# Copia este archivo a `.env` (que NO se sube a git) y completa los valores.
# Docker Compose lo inyecta en los contenedores; en AWS estas mismas variables
# se configuran en el servicio que ejecuta el backend.

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
# Con Docker Compose es el nombre del servicio (bd). En AWS es el endpoint de RDS,
# por ejemplo: mi-bd.xxxxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_HOST=bd

# --- Seguridad ---------------------------------------------------------------
# Clave de firma del JWT, en Base64 y de al menos 32 bytes:  openssl rand -base64 32
SECRET_KEY_BACKEND=

# --- Administrador inicial ---------------------------------------------------
# El backend crea esta cuenta al arrancar si no existe. Sin estas dos variables
# no se crea ningún administrador (no hay credenciales por defecto en el código).
# Evita el carácter `$` en la contraseña: Compose puede interpretarlo como variable.
ADMIN_EMAIL=
ADMIN_PASSWORD=
